{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ifs-editor",
  "version-string": "0.1.0",
  "description": "IFS editor for 573Renderer: a Qt 6 application that edits IFS packages and previews them through a separate host process.",
  "dependencies": [
    "catch2",
    "flatbuffers",
    "hash-library",
    "nlohmann-json",
    "stb",
    "qt-advanced-docking-system",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "jpeg",
        "png",
        "widgets"
      ]
    },
    "tl-expected"
  ]
}
